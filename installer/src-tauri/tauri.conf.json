{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hoist Setup",
  "version": "0.1.0",
  "identifier": "com.hoist.installer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hoist 설치",
        "width": 520,
        "height": 420,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
