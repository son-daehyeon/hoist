{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hoist",
  "version": "0.1.0",
  "identifier": "com.hoist.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hoist",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["fonts/*"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2QjUwM0YyREY3MjhGM0UKUldRK2ozTGY4Z08xdHR2VWk3UXRPdkgvdUxaUWVYR1B1d04wNGJna21KdnFjMk5QSFM2b1o3ekkK",
      "endpoints": ["https://github.com/son-daehyeon/hoist-releases/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
